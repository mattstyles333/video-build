{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattstyles333/video-build/schemas/edl.schema.json",
  "title": "video-build EDL",
  "type": "object",
  "required": ["sources", "ranges"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/range" }
    },
    "grade": { "type": "string" },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlay" }
    },
    "subtitles": { "type": "string", "minLength": 1 },
    "audio_tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/audio_track" }
    },
    "subtitle_style": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "total_duration_s": { "type": "number", "exclusiveMinimum": 0 }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["source", "end"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number" },
        "beat": { "type": "string" },
        "quote": { "type": "string" },
        "reason": { "type": "string" },
        "kenburns": { "type": "boolean" },
        "fade_in": { "type": "number", "minimum": 0 },
        "fade_out": { "type": "number", "minimum": 0 },
        "transition_out": { "type": "string" },
        "transition_duration": { "type": "number", "minimum": 0 },
        "duck": { "type": "boolean" },
        "picture": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": ["source"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "start": { "type": "number", "minimum": 0 },
                "kenburns": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": ["file", "start_in_output", "duration"],
      "additionalProperties": true,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "start_in_output": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "beat": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in": { "type": "number", "minimum": 0 },
        "fade_out": { "type": "number", "minimum": 0 }
      }
    },
    "audio_track": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": true,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "start_in_output": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "loop": { "type": "boolean" },
        "duck": { "type": "boolean" },
        "duck_db": { "type": "number" },
        "role": { "type": "string" }
      }
    }
  }
}
